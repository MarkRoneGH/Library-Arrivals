<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proj.markrone.library.client.gui.controllers.UsersController">

    <Label styleClass="title">Управление пользователями</Label>

    <HBox styleClass="workflowHBox">
        <StackPane styleClass="form-side-panel">
            <VBox styleClass="buttonsVBox">
                <Button fx:id="addButton" onAction="#onAddButton" text="Добавить пользователя" styleClass="button-primary" />
                <Button fx:id="deleteButton" onAction="#onDeleteButton" text="Удалить пользователя" styleClass="button-danger" />
            </VBox>
        </StackPane>

        <StackPane styleClass="table-card">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS" />
            </HBox.hgrow>
            <TableView fx:id="usersTable">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" />
                    <TableColumn fx:id="firstNameColumn" text="Имя" />
                    <TableColumn fx:id="lastNameColumn" text="Фамилия" />
                    <TableColumn fx:id="patronymicColumn" text="Отчество" />
                    <TableColumn fx:id="usernameColumn" text="Имя пользователя" />
                    <TableColumn fx:id="roleColumn" text="Роль" />
                </columns>
            </TableView>
        </StackPane>

        <StackPane styleClass="table-card">
            <VBox styleClass="buttonsVBox">
                <HBox styleClass="workflowHBox">
                    <VBox styleClass="buttonsVBox">
                        <TextField fx:id="usernameField" promptText="Введите имя пользователя *" />
                        <PasswordField fx:id="passwordField" promptText="Введите пароль *" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Подтвердите пароль *" />
                        <ComboBox fx:id="rolesComboBox" promptText="Выберите роль *"/>
                    </VBox>

                    <VBox styleClass="buttonsVBox">
                        <TextField fx:id="firstNameField" promptText="Введите имя *" />
                        <TextField fx:id="lastNameField" promptText="Введите фамилию *" />
                        <TextField fx:id="patronymicField" promptText="Введите отчество" />
                    </VBox>
                </HBox>

                <Button fx:id="eraseButton" onAction="#onEraseButton" text="Очистить данные" styleClass="button-secondary" />

                <Button fx:id="updateButton" onAction="#onUpdateButton" text="Обновить данные пользователя" styleClass="button-secondary" />
            </VBox>
        </StackPane>
    </HBox>

    <Button fx:id="backButton" onAction="#onBackButton" text="В меню" styleClass="button-secondary" />
</VBox>
