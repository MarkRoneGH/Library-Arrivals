<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proj.markrone.library.client.gui.controllers.BooksController">

    <Label styleClass="title">Каталог книг</Label>

    <TextField fx:id="searchField" promptText="Поиск по названию, автору, ISBN..." onAction="#onSearchAction" />

    <HBox styleClass="workflowHBox">
        <StackPane styleClass="form-side-panel">
            <VBox styleClass="buttonsVBox">
                <Button fx:id="addButton" onAction="#onAddButton" text="Добавить книгу" styleClass="button-primary" />
                <Button fx:id="deleteButton" onAction="#onDeleteButton" text="Удалить книгу" styleClass="button-danger" />
                <Button fx:id="updateButton" onAction="#onUpdateButton" text="Обновить данные" styleClass="button-secondary" />
            </VBox>
        </StackPane>

        <StackPane styleClass="table-card">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS" />
            </HBox.hgrow>
            <TableView fx:id="booksTable">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" />
                    <TableColumn fx:id="titleColumn" text="Название" />
                    <TableColumn fx:id="authorColumn" text="Автор" />
                    <TableColumn fx:id="isbnColumn" text="ISBN" />
                    <TableColumn fx:id="yearColumn" text="Год" />
                </columns>
            </TableView>
        </StackPane>

        <StackPane styleClass="table-card">
            <VBox styleClass="buttonsVBox">
                <TextField fx:id="titleField" promptText="Название" />
                <TextField fx:id="authorField" promptText="Автор" />
                <TextField fx:id="isbnField" promptText="ISBN" />
                <TextField fx:id="yearField" promptText="Год издания" />

                <Button fx:id="eraseButton" onAction="#onEraseButton" text="Очистить" styleClass="button-secondary" />
            </VBox>
        </StackPane>

    </HBox>

    <HBox styleClass="workflowHBox">
        <Button fx:id="exportToExcelButton" onAction="#onExportToExcelButton" text="Экспорт в Excel" styleClass="button-secondary" />
        <Button fx:id="exportToPDFButton" onAction="#onExportToPDFButton" text="Экспорт в PDF" styleClass="button-secondary" />
        <Button fx:id="exportToJSONButton" onAction="#onExportToJSONButton" text="Экспорт в JSON" styleClass="button-secondary" />
    </HBox>

    <Button fx:id="backToMenuButton" onAction="#onBackToMenuButton" text="В меню" styleClass="button-secondary" />
</VBox>
