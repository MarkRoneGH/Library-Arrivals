<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proj.markrone.library.client.gui.controllers.BookCopiesController">

    <Label styleClass="title">Экземпляры книг</Label>

    <ComboBox fx:id="statusFilterComboBox" promptText="Фильтр по статусу" onAction="#onStatusFilter" />

    <HBox styleClass="workflowHBox">
        <StackPane styleClass="form-side-panel">
            <VBox styleClass="buttonsVBox">
                <Button fx:id="registerButton" onAction="#onRegisterButton" text="Зарегистрировать" styleClass="button-primary" />
                <Button fx:id="includeInFundButton" onAction="#onIncludeInFundButton" text="Включить в фонд" />
                <Button fx:id="deleteButton" onAction="#onDeleteButton" text="Удалить экземпляр" styleClass="button-danger" />
                <Button fx:id="writeOffButton" onAction="#onWriteOffButton" text="Списать" styleClass="button-danger" />
                <Button fx:id="relocateButton" onAction="#onRelocateButton" text="Переместить" styleClass="button-secondary" />
                <Button fx:id="refreshButton" onAction="#onRefreshButton" text="Обновить список" styleClass="button-secondary" />
            </VBox>
        </StackPane>

        <StackPane styleClass="table-card">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS" />
            </HBox.hgrow>
            <TableView fx:id="copiesTable">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" />
                    <TableColumn fx:id="bookColumn" text="Книга" />
                    <TableColumn fx:id="arrivalColumn" text="Поступление" />
                    <TableColumn fx:id="invColumn" text="Инв. номер" />
                    <TableColumn fx:id="shelfColumn" text="Полка" />
                    <TableColumn fx:id="statusColumn" text="Статус" />
                </columns>
            </TableView>
        </StackPane>

        <StackPane styleClass="table-card">
            <VBox styleClass="buttonsVBox">
                <ComboBox fx:id="bookComboBox" promptText="Выберите книгу" />
                <ComboBox fx:id="arrivalComboBox" promptText="Выберите поступление" />
                <TextField fx:id="inventoryField" promptText="Инвентарный номер" />
                <TextField fx:id="shelfField" promptText="Полка (стеллаж)" />
                <Button fx:id="eraseButton" onAction="#onEraseButton" text="Очистить" styleClass="button-secondary" />
            </VBox>
        </StackPane>
    </HBox>

    <Button fx:id="backToMenuButton" onAction="#onBackToMenuButton" text="В меню" styleClass="button-secondary" />
</VBox>
