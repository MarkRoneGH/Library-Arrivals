<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proj.markrone.library.client.gui.controllers.ArrivalsController">

    <Label styleClass="title">Поступления книг</Label>

    <HBox styleClass="workflowHBox">
        <StackPane styleClass="form-side-panel">
            <VBox styleClass="buttonsVBox">
                <Button fx:id="addButton" onAction="#onAddButton" text="Зарегистрировать поступление" styleClass="button-primary" />
                <Button fx:id="updateButton" onAction="#onUpdateButton" text="Обновить запись" styleClass="button-secondary" />
                <Button fx:id="deleteButton" onAction="#onDeleteButton" text="Удалить запись" styleClass="button-danger" />
            </VBox>
        </StackPane>

        <StackPane styleClass="table-card">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS" />
            </HBox.hgrow>
            <TableView fx:id="arrivalsTable">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" />
                    <TableColumn fx:id="dateColumn" text="Дата поступления" />
                    <TableColumn fx:id="notesColumn" text="Примечание" />
                </columns>
            </TableView>
        </StackPane>

        <StackPane styleClass="table-card">
            <VBox styleClass="buttonsVBox">
                <TextField fx:id="notesField" promptText="Примечание к поступлению" />
                <Button fx:id="eraseButton" onAction="#onEraseButton" text="Очистить" styleClass="button-secondary" />
            </VBox>
        </StackPane>

    </HBox>

    <Button fx:id="backToMenuButton" onAction="#onBackToMenuButton" text="В меню" styleClass="button-secondary" />
</VBox>
