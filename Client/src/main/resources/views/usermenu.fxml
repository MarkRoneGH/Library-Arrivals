<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="proj.markrone.library.client.gui.controllers.UserMenuController">

    <VBox alignment="CENTER" spacing="20" maxWidth="Infinity" maxHeight="Infinity">
        <Label styleClass="title">Главное меню</Label>

        <Label fx:id="helloLabel">Добро пожаловать, </Label>

        <Button fx:id="myIssuesButton" onAction="#onMyIssuesButton" text="Мои выдачи" styleClass="button-primary" />
        <Button fx:id="editInfoButton" onAction="#onEditInfoButton" text="Изменить данные" styleClass="button-secondary" />
        <Button fx:id="exitButton" onAction="#onExitButton" text="Выйти из аккаунта" styleClass="button-danger" />
    </VBox>

    <HBox alignment="TOP_RIGHT" pickOnBounds="false" styleClass="menu-theme-overlay" StackPane.alignment="TOP_RIGHT">
        <Button fx:id="themeToggleButton" onAction="#onThemeToggle" styleClass="icon-toggle-theme" />
    </HBox>
</StackPane>
